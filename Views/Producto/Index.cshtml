@model List<PrototipoCRUD.Models.Producto>

<div class="container mt-4">
    <h2>Catálogo de Productos - Minisúper El Ahorro</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">+ Nuevo Producto</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Código de Barras</th>
                <th>Nombre</th>
                <th>Precio (Bs.)</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.CodigoBarras</td>
                    <td>@item.Nombre</td>
                    <td>@item.Precio</td>
                    <td>@item.Stock</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" 
                           onclick="return confirm('¿Seguro que deseas eliminar este producto?');">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
